{
  "name": "dataops-lakehouse-platform",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm@sha256:7876580dc67fd460fd962f004cbeb480027e9bbc0657096f1087db11f9eaff39",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1.5.0": { "version": "1.16.5" },
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {}
  },
  "containerEnv": {
    "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/transform",
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "pipx install uv==0.13.0 && uv sync --frozen && cd transform && uv run --frozen dbt deps",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Dagster UI" },
    "8080": { "label": "dbt docs" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "innoverio.vscode-dbt-power-user",
        "dorzey.vscode-sqlfluff",
        "hashicorp.terraform",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ]
    }
  }
}
